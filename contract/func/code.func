() recv_internal(int msg_value, cell in_msg, slice in_msg_body) impure {
    ;; Проверяем, что тело сообщения не пустое
    if (in_msg_body.slice_empty?()) {
        return ();
    }

    ;; Читаем op-code (для фильтрации сообщений)
    int op = in_msg_body~load_uint(32); 

    ;; Если op-code = 0x12345678 (пример кастомного кода)
    if (op == 0x12345678) {
        ;; Читаем сообщение от отправителя
        slice sender_address = in_msg_body~load_msg_addr();
        slice message = in_msg_body~load_slice(in_msg_body.slice_bits());

        ;; Отправляем ответную транзакцию
        var msg = begin_cell()
            .store_uint(0x18, 6) ;; флаги
            .store_slice(sender_address) ;; кому отправляем
            .store_coins(1 * 10000000) ;; 0.01 TON
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1) ;; default message headers
            .store_slice("Hello from contract! Your message: ")
            .store_slice(message)
        .end_cell();

        send_raw_message(msg, 3); ;; mode 3 = pay fees separately
    }
}